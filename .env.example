# cp .env.example .env
# Compose reads .env automatically. It is ignored by .gitignore and .dockerignore,
# so it never reaches a commit or an image.
# The values below are for a local database that is not published on the host.
# Never reuse them anywhere else.

DB_PASSWORD=dev-password-local-only
SECRET_KEY=dev-secret-key-local-only

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Host user and group ids; run `id -u` and `id -g` if yours are not 1000.
APP_UID=1000
APP_GID=1000
